# APIキーはこのファイルではなく .env に書く(.env は git 管理外)。
# 1プロバイダに複数のキーを持てる: 基準名に _2, _3 ... を付けて連番で並べる。
#   例) GROQ_API_KEY=... / GROQ_API_KEY_2=... / GROQ_API_KEY_3=...
# どの変数名を使うかは providers/providers.json の keys_env で決まる。
MISTRAL_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
